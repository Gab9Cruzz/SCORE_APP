# Postgres ya creado (ver /database para el esquema). La base se llama
# "torneos_mvp" (con "s" — ojo, no "torneo_mvp"). Ajustar host/puerto/clave
# si tu instancia no corre en localhost:5432.
#
# Driver: psycopg (async), no asyncpg. En Windows, asyncpg no logra abrir
# conexión alguna corriendo bajo uvicorn (falla con WinError 64 apenas se
# intenta la primera query, tanto en el arranque como en cada request) —
# probado en este proyecto, no es un caso aislado. psycopg sí funciona,
# pero solo con SelectorEventLoop: ver backend/run.py y la sección
# "Correr local (Windows)" del README.
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/torneos_mvp

# Base de datos usada por la suite de tests (se crea y se reconstruye sola
# corriendo los .sql de /database; nunca toca torneos_mvp). Ver backend/tests/conftest.py.
TEST_DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/torneos_mvp_test

# JWT. Generar uno propio en cada entorno, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-please-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Primer usuario Admin: si al arrancar la tabla usuarios está vacía, la API
# lo crea sola con estas credenciales. No hace falta correrlo dos veces.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_NOMBRE=Administrador

# CORS: orígenes permitidos, separados por coma. "*" en desarrollo.
CORS_ORIGINS=*

API_V1_PREFIX=/api/v1
