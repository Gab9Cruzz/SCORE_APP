# URL base del backend (FastAPI). Sin esto, frontend/src/api/client.ts:4 lee
# `import.meta.env.VITE_API_BASE_URL` como `undefined` y el login (auth/
# AuthContext.tsx:72) POSTea a "undefined/api/v1/auth/login" — el backend
# nunca ve el request. Copiá este archivo a .env (git lo ignora) y ajustá
# el puerto si tu backend no corre en el 8000 por default.
VITE_API_BASE_URL=http://127.0.0.1:8000
